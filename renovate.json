{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 9am on saturday"
  ],
  "labels": [
    "renovate"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/k8s/.+\\.yml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in bjw-s app-template (repository + tag)",
      "managerFilePatterns": [
        "/k8s/.+\\.yml$/"
      ],
      "matchStrings": [
        "repository:\\s+(?<depName>\\S+)\\n\\s+tag:\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Inline container image references (image: name:tag)",
      "managerFilePatterns": [
        "/k8s/.+\\.yml$/"
      ],
      "matchStrings": [
        "image: (?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ArgoCD install manifest version",
      "managerFilePatterns": [
        "/k8s/(bootstrap|components)/.+\\.yml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>[^/]+)/manifests/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "ArgoCD version the drift alert expects; updated with the install manifest",
      "managerFilePatterns": [
        "/k8s/clusters/homelabk8s01/infrastructure/kube-prometheus-stack/homelab-rules\\.yml$/"
      ],
      "matchStrings": [
        "quay\\.io/argoproj/argocd:(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "HTTP Helm charts in ApplicationSet config.yml files",
      "managerFilePatterns": [
        "/k8s/clusters/.+/config\\.yml$/"
      ],
      "matchStrings": [
        "chartRepo: *[\\\"\\']?(?<registryUrl>https?://[^\\s\\\"\\']+)[\\\"\\']?\\s+chartName: *[\\\"\\']?(?<depName>[^\\s\\\"\\']+)[\\\"\\']?\\s+chartVersion: *[\\\"\\']?(?<currentValue>[^\\s\\\"\\']+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "OCI Helm charts in ApplicationSet config.yml files",
      "managerFilePatterns": [
        "/k8s/clusters/.+/config\\.yml$/"
      ],
      "matchStrings": [
        "chartRepo: *[\\\"\\']?(?<chartRegistry>ghcr\\.io/[^\\s\\\"\\']+)[\\\"\\']?\\s+chartName: *[\\\"\\']?(?<depName>[^\\s\\\"\\']+)[\\\"\\']?\\s+chartVersion: *[\\\"\\']?(?<currentValue>[^\\s\\\"\\']+)"
      ],
      "packageNameTemplate": "{{{chartRegistry}}}/{{{depName}}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Group app-template chart updates",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "app-template"
      ],
      "groupName": "app-template chart"
    },
    {
      "description": "Group linuxserver container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^lscr\\.io\\/linuxserver\\//"
      ],
      "groupName": "linuxserver images"
    },
    {
      "description": "Group monitoring stack charts",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "kube-prometheus-stack",
        "loki",
        "alloy"
      ],
      "groupName": "monitoring stack"
    },
    {
      "description": "Group backup stack charts",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "minio",
        "velero"
      ],
      "groupName": "backup stack"
    },
    {
      "description": "Group VPA and Goldilocks charts",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "vertical-pod-autoscaler",
        "goldilocks"
      ],
      "groupName": "vpa & goldilocks"
    },
    {
      "description": "Group Intel GPU charts",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "intel-device-plugins-gpu",
        "intel-device-plugins-operator"
      ],
      "groupName": "intel gpu"
    },
    {
      "description": "Ignore linuxserver Ubuntu base image tags for qbittorrent",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "description": "Keep the media-operator CRDs and managers on one release",
      "matchPackageNames": [
        "/^ghcr\\.io/kyleseneker/media-operator//"
      ],
      "groupName": "media-operator charts",
      "pinDigests": false
    },
    {
      "description": "Postgres 18 changes the on-disk format; hold at 17 until the dump-and-restore cutover",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "library/postgres"
      ],
      "allowedVersions": "/^17\\./"
    },
    {
      "description": "Descheduler is built per Kubernetes minor; stay within one minor of the cluster (1.35)",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "descheduler"
      ],
      "allowedVersions": "<0.37.0"
    },
    {
      "description": "VPA chart 0.12 drops RBAC its 1.7 recommender still needs for checkpoint cleanup, and VPA 1.8 needs Kubernetes 1.36",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "vertical-pod-autoscaler"
      ],
      "allowedVersions": "<0.12.0"
    },
    {
      "description": "kube-prometheus-stack 84 brings the Grafana 13 migration; lift one major at a time",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "kube-prometheus-stack"
      ],
      "allowedVersions": "<84.0.0"
    },
    {
      "description": "Loki 7 leaves the grafana chart repo; hold until the move to the community chart",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "loki"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "etcd backup tooling follows kubeadm; update during a staged Kubernetes upgrade",
      "matchPackageNames": [
        "registry.k8s.io/etcd"
      ],
      "enabled": false
    }
  ]
}
