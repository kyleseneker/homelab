proxmox_endpoint = "https://192.168.10.2:8006"
target_node      = "homelabpve01"

clone_template_id = 9011
ssh_public_key    = "ssh-ed25519 AAAA... dedicated-lab-key"

bridge     = "vmbr1"
gateway    = "172.26.0.1"
nameserver = "1.1.1.1"
username   = "labadmin"

# The verified Packer template includes the guest agent.
agent_enabled = true
onboot        = false
tags          = ["restore-lab", "k8s"]

nodes = {
  homelabrestore01-node-1 = {
    role      = "control-plane"
    ip        = "172.26.0.10/24"
    vm_id     = 300
    cores     = 2
    memory    = 4096
    disk_size = 32
  }
  homelabrestore01-node-2 = {
    role      = "worker"
    ip        = "172.26.0.11/24"
    vm_id     = 301
    cores     = 2
    memory    = 4096
    disk_size = 32
  }
}
